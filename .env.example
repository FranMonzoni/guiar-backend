# ── Base de datos ─────────────────────────────────────────────────────────────
# Postgres. Las dos URLs salen de la consola de Neon (Connection string) y apuntan a la misma base.
# Conexión POOLED (el host termina en -pooler): la usa el backend para las consultas.
DATABASE_URL="postgresql://usuario:clave@ep-ejemplo-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Conexión DIRECTA (el host no tiene -pooler): la usa Prisma para aplicar migraciones.
DIRECT_URL="postgresql://usuario:clave@ep-ejemplo-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

PORT=3001

# Orígenes permitidos para CORS (separados por coma). Vacío = cualquiera (solo para desarrollo).
CORS_ORIGINS="http://localhost:5173"

# ── Firebase ──────────────────────────────────────────────────────────────────
# Web API Key del proyecto (la misma que VITE_FIREBASE_API_KEY del frontend).
# La usa /api/auth/login, /register y /refresh para que la app móvil se loguee por REST.
FIREBASE_WEB_API_KEY="tu_api_key"

# Credenciales del Admin SDK. Usá UNA de las dos opciones:
#  a) ruta al JSON descargado de la consola de Firebase (por defecto ./serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"
#  b) el JSON completo en una sola línea (útil para Render/Railway/etc.)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# ── Administración ────────────────────────────────────────────────────────────
# Emails que reciben rol ADMIN automáticamente al iniciar sesión (separados por coma).
ADMIN_EMAILS=""

# ── Ubicaciones ───────────────────────────────────────────────────────────────
# Horas que se conserva el historial de ubicaciones (después se borra).
LOCATION_RETENTION_HOURS=48
# Mínimo de milisegundos entre dos ubicaciones guardadas en la DB por usuario.
# (Todas se retransmiten en vivo; esto solo limita lo que se persiste.)
LOCATION_MIN_INTERVAL_MS=2000
