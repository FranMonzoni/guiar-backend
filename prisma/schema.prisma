// GuiAR — esquema de base de datos
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String     @id @default(cuid())
  firebaseUid String     @unique // UID de Firebase Auth
  email       String?    @unique
  displayName String     @default("Usuario")
  role        String     @default("USER") // "USER" | "ADMIN"

  // Un usuario pertenece como máximo a UN grupo (groupId nullable, no es una relación N:N).
  groupId     String?
  group       Group?     @relation("GroupMembers", fields: [groupId], references: [id], onDelete: SetNull)
  joinedAt    DateTime?

  ownedGroups Group[]    @relation("GroupOwner")
  locations   Location[]
  device      Device?    // la pulsera vinculada (como máximo una)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([groupId])
}

model Group {
  // ID público del grupo. Viaja en cada mensaje del WebSocket ("groupId").
  id            String     @id @default(cuid())
  name          String

  // Código corto para invitar gente (ej: "K7P3QX9M"). El owner puede regenerarlo.
  inviteCode    String     @unique

  // Clave secreta AES-256 (32 bytes, guardada en hex) que usan la app y las pulseras
  // para cifrar lo que se mandan por LoRa. La API la entrega en base64 y solo a
  // miembros del grupo; nunca al panel de administración ni a los logs.
  encryptionKey String
  // Sube en 1 cada vez que la clave se renueva (al salir o quitar un miembro).
  keyVersion    Int        @default(1)
  keyRotatedAt  DateTime?

  ownerId       String
  owner         User       @relation("GroupOwner", fields: [ownerId], references: [id])
  members       User[]     @relation("GroupMembers")
  locations     Location[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Location {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  deviceId   String    @default("unknown")
  latitude   Float
  longitude  Float
  altitude   Float?    // metros
  speed      Float?    // m/s
  heading    Float?    // grados 0-360 (magnetómetro / rumbo GPS)
  accuracy   Float?    // metros
  hdop       Float?    // dilución horizontal de precisión del GPS (sin unidad)
  gpsFix     Boolean?  // el GPS de la pulsera tenía fix
  simulated  Boolean   @default(false) // la app marcó la ubicación como simulada
  satellites Int?
  battery    Float?    // %
  signal     Float?    // RSSI dBm (LoRa)

  // Campos extra chicos del JSON de la ESP (ej. accel). La telemetría completa
  // NO se guarda por punto: solo la última, en Device.telemetry.
  extra      String?

  deviceTime DateTime? // hora que reporta la ESP / app
  timestamp  DateTime  @default(now()) // hora en que llegó al servidor

  @@index([groupId, timestamp])
  @@index([userId, timestamp])
}

// Pulsera vinculada a un usuario. Regla: una pulsera por usuario y un usuario por pulsera.
// Se vincula sola con la primera ubicación que manda; para cambiarla hay que desvincularla.
model Device {
  id         String    @id @default(cuid())
  deviceId   String    @unique // ID que reporta la pulsera (esp.deviceId)
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?   // telemetry.sensors.identity.data.name
  firmware   String?   // telemetry.sensors.identity.data.fw
  lastSeenAt DateTime?
  telemetry  String?   // último bloque esp.telemetry recibido (JSON)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
